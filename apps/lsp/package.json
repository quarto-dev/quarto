    "core": "*",
    "core-node": "*",
    "editor-server": "*",
    "editor-types": "*",
    "file-url": "^4.0.0",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.2",
    "node-html-parser": "^9.0.4",
    "picomatch": "^4.0.7",
    "quarto-core": "*",
    "quarto-utils": "*",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-languageserver-types": "^3.18.4",
    "vscode-uri": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/picomatch": "^4.0.3",
    "build": "*",
    "eslint": "^10.11.0",
    "eslint-config-custom-server": "*",
    "tsconfig": "*",
