{
  "name": "quarto-lsp",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "dev": "yarn run build dev",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
