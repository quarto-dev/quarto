{
  "name": "quarto",
  "version": "1.86.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/ojs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev-vscode": "turbo run dev --filter quarto...",
    "build-vscode": "turbo run build --filter quarto...",
    "test-vscode": "cd apps/vscode && yarn test",
    "test-positron": "cd apps/vscode && yarn test-positron",
    "test-packages": "turbo run test --filter='./packages/*' --filter=quarto-vscode-markdownit --filter=quarto-lsp",
    "install-vscode": "cd apps/vscode && yarn install-vscode",
    "install-positron": "cd apps/vscode && yarn install-positron",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^2.5.1",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3"
  }
}
