{
  "name": "quarto",
  "version": "1.86.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev-vscode": "turbo run dev --filter quarto...",
    "build-vscode": "turbo run build --filter quarto...",
    "test-vscode": "cd apps/vscode && npm test --",
    "test-positron": "cd apps/vscode && npm run test-positron --",
    "test-packages": "turbo run test --filter='./packages/*' --filter=quarto-vscode-markdownit --filter=quarto-lsp",
    "install-vscode": "cd apps/vscode && npm run install-vscode",
    "install-positron": "cd apps/vscode && npm run install-positron",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^2.5.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "mermaid": {
      "katex": "^0.18.2"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": true,
    "core-js-pure": false,
    "keytar": false,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
